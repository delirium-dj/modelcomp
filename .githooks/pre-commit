#!/bin/sh
# modelcomp guard: RULES.md (precedence #1) forbids deleting research files.
# Blocks commits that delete tracked model/**/*.md or *.md.excluded files.
# Activate once per clone:  git config core.hooksPath .githooks
# Bypass (explicit user sign-off only):  ALLOW_MODEL_DELETE=1 git commit ...
set -u
# Retired duplicate root (RULES.md voice-routing rule): voicemodels/ is the
# pre-2026-09-28 name of models_voice/ and must never be recreated. Block any
# staged addition under it — merge into the matching models_voice/<slug>/
# folder instead.
retired="$(git diff --cached --name-only --diff-filter=A -z -- voicemodels | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$retired" ]; then
  echo "BLOCKED by RULES.md: voicemodels/ is a retired duplicate of models_voice/ — never recreate it:" >&2
  printf '%s\n' "$retired" >&2
  echo "Move these files into the matching models_voice/<slug>/ folders and unstage voicemodels/," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Slug version convention (model/README.md): version numbers use "." not "-".
# Block staged additions under hyphen-versioned model folders — they FAIL
# `pnpm sync` (hyphenVersionViolation in scripts/lib/naming.mjs), so catching
# them here saves a failed sync pass. Rename to the dotted slug first (e.g.
# model/gemma-4-12b-unified/ -> model/gemma-4.12b-unified/). Param-size
# exceptions (NOT versions): gemma-4-31b, qwen-3.8-27b, qwen-3.5-9b,
# qwen-3.5-397b, qwen-3.5-27b, qwen-3.5-35b-a3b, qwen-3.5-122b-a10b.
hyphen_added="$(git diff --cached --name-only --diff-filter=A -z -- model | tr '\0' '\n' | grep -E '^model/[^/]*/' || true)"
hyphen_blocked=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  slug="$(printf '%s' "$f" | sed -e 's|^model/||' -e 's|/.*$||')"
  case "$slug" in
    gemma-4-31b|qwen-3.8-27b|qwen-3.5-9b|qwen-3.5-397b|qwen-3.5-27b|qwen-3.5-35b-a3b|qwen-3.5-122b-a10b) continue;;
  esac
  case "$slug" in
    *[0-9]-[0-9]*)
      # Digit-hyphen-digit is a violation ONLY when the trailing digit run is
      # not a param size (digits, optional decimal, immediately followed by
      # b/B - e.g. 4-12b, 26b-a4b, 8-325b) - mirror of naming.mjs
      # normalizeSlug's negative lookahead (?!\d+(?:\.\d+)?[bB]).
      paramless="$(printf '%s' "$slug" | sed -E 's/[0-9]-[0-9]+(\.[0-9]+)?[bB]/X/g')"
      case "$paramless" in
        *[0-9]-[0-9]*) hyphen_blocked="${hyphen_blocked}${f}\n";;
      esac
      ;;
  esac
done <<EOF
$hyphen_added
EOF
if [ -n "$hyphen_blocked" ]; then
  echo "BLOCKED by model/README.md slug convention (version numbers use \".\" not \"-\"):" >&2
  printf '%b' "$hyphen_blocked" >&2
  echo "Rename to the dotted slug first (e.g. model/gemma-4-12b-unified/ -> model/gemma-4.12b-unified/)," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Merged-and-deleted duplicate slugs (RULES.md vendor-prefix identity):
# model/google-gemini-2.5-flash-lite/ was folded into
# model/gemini-2.5-flash-lite/ on user order — block any staged addition
# under it so the duplicate can never be re-cemented. Research/report under
# model/gemini-2.5-flash-lite/ instead.
merged_added="$(git diff --cached --name-only --diff-filter=A -z -- model/google-gemini-2.5-flash-lite | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$merged_added" ]; then
  echo "BLOCKED by RULES.md: model/google-gemini-2.5-flash-lite/ is a merged duplicate of model/gemini-2.5-flash-lite/ — never recreate it:" >&2
  printf '%s\n' "$merged_added" >&2
  echo "Write into model/gemini-2.5-flash-lite/ instead," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Renamed duplicate slug (RULES.md GLM-5.1 coding-suffix identity):
# model/glm-5.1-coding/ was renamed to model/glm-5.1/ on user order
# (no separate "-Coding" SKU exists; meta.json ID is opencode/glm-5.1) —
# block any staged addition under the old slug so the duplicate can never be
# re-cemented. Research/report under model/glm-5.1/ instead.
renamed_added="$(git diff --cached --name-only --diff-filter=A -z -- model/glm-5.1-coding | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$renamed_added" ]; then
  echo "BLOCKED by RULES.md: model/glm-5.1-coding/ was renamed to model/glm-5.1/ — never recreate it:" >&2
  printf '%s\n' "$renamed_added" >&2
  echo "Write into model/glm-5.1/ instead," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Merged reasoning-alias duplicate slugs (RULES.md Grok Fast reasoning-alias
# identity): model/grok-4-fast-reasoning/ was folded into model/grok-4-fast/
# and model/grok-4.1-fast-reasoning/ into model/grok-4.1-fast/ on user order
# (docs.x.ai aliases — same checkpoint) — block any staged addition under the
# old slugs so the duplicates can never be re-cemented. Research/report under
# the -fast folders instead.
grok_reasoning_added="$(git diff --cached --name-only --diff-filter=A -z -- model/grok-4-fast-reasoning model/grok-4.1-fast-reasoning | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$grok_reasoning_added" ]; then
  echo "BLOCKED by RULES.md: grok-*-fast-reasoning folders are merged aliases of grok-4-fast / grok-4.1-fast — never recreate them:" >&2
  printf '%s\n' "$grok_reasoning_added" >&2
  echo "Write into model/grok-4-fast/ or model/grok-4.1-fast/ instead," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Merged duplicate slug (RULES.md slug identity): model/longcat_2.5_preview/
# (underscores) folded into the dotted model/longcat-2.5-preview/ and deleted
# on user order (2026-10-23; both folders declared id
# opencode/longcat-2.5-preview-free — one model) — block any staged addition
# under the underscore slug. Research/report under longcat-2.5-preview instead.
longcat_underscore_added="$(git diff --cached --name-only --diff-filter=A -z -- model/longcat_2.5_preview | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$longcat_underscore_added" ]; then
  echo "BLOCKED by RULES.md: model/longcat_2.5_preview/ is a merged duplicate of model/longcat-2.5-preview/ — never recreate it:" >&2
  printf '%s\n' "$longcat_underscore_added" >&2
  echo "Write into model/longcat-2.5-preview/ instead," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Merged revealed-stealth slugs (RULES.md revealed-stealth identity, user
# rule 2026-10-24): model/space-bunny/ was merged into
# model/minimax-m3.1-flash-preview/ (stealth slot revealed 2026-10-19 as
# MiniMax M3.1 Flash Free) and model/cat-jam/ into model/beam/ (revealed as
# Reflection Beam 1.0) on user order — block any staged addition under the
# stealth slugs so they can never be re-cemented. Searching the stealth names
# resolves via the revealed models' meta `aliases`.
stealth_added="$(git diff --cached --name-only --diff-filter=A -z -- model/space-bunny model/space-bunny-alpha model/space-bunny-free model/cat-jam model/cat-jam-free | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$stealth_added" ]; then
  echo "BLOCKED by RULES.md: model/space-bunny/ and model/cat-jam/ are merged revealed-stealth aliases of model/minimax-m3.1-flash-preview/ resp. model/beam/ — never recreate them:" >&2
  printf '%s\n' "$stealth_added" >&2
  echo "Write into model/minimax-m3.1-flash-preview/ or model/beam/ instead," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Retired vendor alias (RULES.md retired-alias identity):
# grok-code-fast-1 is a vendor-published alias of model/grok-build-0.1/
# (docs.x.ai) and must never become a folder — block any staged addition
# under it (sync also FAILs it via RETIRED_ALIAS_SLUGS).
# Research/report under model/grok-build-0.1/ instead.
alias_added="$(git diff --cached --name-only --diff-filter=A -z -- model/grok-code-fast-1 | tr '\0' '\n' | grep -E '.' || true)"
if [ -n "$alias_added" ]; then
  echo "BLOCKED by RULES.md: model/grok-code-fast-1/ is a retired vendor alias of model/grok-build-0.1/ — never scaffold it:" >&2
  printf '%s\n' "$alias_added" >&2
  echo "Write into model/grok-build-0.1/ instead," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Merged-and-deleted duplicate findings-file stems (RULES.md findings-stem
# identity): Mimo_v2.6_Flash.md was folded into MiMo_2.6_Flash.md on user
# order (same Xiaomi rater, 2026-10-09); Space_Bunny -> MiniMax_M3.1_Flash,
# Cat_Jam -> Beam and Ox_Alpha -> GLM_5.3_Flash followed on user order
# 2026-10-26 (revealed-stealth rater merge) — block any staged addition under
# a variant spelling so duplicates can never be re-cemented (sync also FAILs
# them via MERGED_SOURCE_STEMS). Write the canonical stem instead.
merged_stem_added="$(git diff --cached --name-only --diff-filter=A -z -- model models_voice models_finance | tr '\0' '\n' | grep -E '(Mimo_v2\.6_Flash|Space_Bunny|Cat_Jam|Ox_Alpha)\.md(\.excluded)?$' || true)"
if [ -n "$merged_stem_added" ]; then
  echo "BLOCKED by RULES.md: merged duplicate findings-file stems (MERGED_SOURCE_STEMS in scripts/lib/validate.mjs: Mimo_v2.6_Flash -> MiMo_2.6_Flash; Space_Bunny -> MiniMax_M3.1_Flash; Cat_Jam -> Beam; Ox_Alpha -> GLM_5.3_Flash) — never recreate them:" >&2
  printf '%s\n' "$merged_stem_added" >&2
  echo "Write into the canonical stem instead (e.g. MiniMax_M3.1_Flash.md, Beam.md, GLM_5.3_Flash.md, MiMo_2.6_Flash.md)," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
# Findings-stem version convention (RULES.md findings-stem identity):
# version numbers in findings-file stems use "." not "_" between digits.
# Block staged additions of underscore-versioned findings files — they FAIL
# `pnpm sync` (stemVersionViolation in scripts/lib/naming.mjs), so catching
# them here saves a failed sync pass. Write the dotted stem instead (e.g.
# model/foo/Laguna_XS_2_1.md -> model/foo/Laguna_XS_2.1.md). Param-size joins
# (digits immediately followed by b/B) are NOT versions and stay underscored
# (mirror of normalizeStem's (?!\d+[bB]) rule): strip them before the check.
stem_added="$(git diff --cached --name-only --diff-filter=A -z -- model | tr '\0' '\n' | grep -E '\.md(\.excluded)?$' || true)"
stem_blocked=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  stem="$(basename "$f" | sed -e 's|\.excluded$||' -e 's|\.md$||')"
  stripped="$(printf '%s' "$stem" | sed -e 's/[0-9][0-9]*[bB]//g')"
  case "$stripped" in
    *[0-9]_[0-9]*) stem_blocked="${stem_blocked}${f}\n";;
  esac
done <<EOF
$stem_added
EOF
if [ -n "$stem_blocked" ]; then
  echo "BLOCKED by RULES.md findings-stem convention (version numbers use \".\" not \"_\" between digits):" >&2
  printf '%b' "$stem_blocked" >&2
  echo "Write the dotted stem instead (e.g. Laguna_XS_2_1.md -> Laguna_XS_2.1.md)," >&2
  echo "or get explicit user sign-off, then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
deleted="$(git diff --cached --name-only --diff-filter=D -z -- model | tr '\0' '\n' | grep -E '\.md(\.excluded)?$' || true)"
# Scratch lifecycle grace (user-signed 2026-09-29, mirrors sync tripwire):
# files added to git < 7 days ago may be agent scratch — warn, allow.
# meta.json is curated infrastructure: always blocked. Unknown age: blocked.
GRACE_DAYS=7
now=$(date +%s)
blocked=""
recent=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    # Twin retirement (tasks/research.md Step 3.3): removing your own
    # .md.excluded twin after filing the fresh .md sibling is sanctioned.
    # Sibling staged or on disk counts — never block completed re-research.
    *.md.excluded)
      sib="${f%.md.excluded}.md"
      if git ls-files --error-unmatch "$sib" >/dev/null 2>&1 || [ -e "$sib" ]; then
        continue
      fi
      ;;
  esac
  case "$f" in
    */meta.json) blocked="${blocked}${f}\n"; continue;;
  esac
  added=$(git log --diff-filter=A --format=%ct -1 HEAD -- "$f" 2>/dev/null || true)
  case "$added" in
    ''|*[!0-9]*) blocked="${blocked}${f}\n"; continue;;
  esac
  if [ "$((now - added))" -lt "$((GRACE_DAYS * 86400))" ]; then
    recent="${recent}${f}\n"
  else
    blocked="${blocked}${f}\n"
  fi
done <<EOF
$deleted
EOF
if [ -n "$recent" ]; then
  printf 'NOTE (scratch grace < %s days, recent agent scratch — allowed):\n%b' "$GRACE_DAYS" "$recent" >&2
fi
if [ -n "$blocked" ]; then
  echo "BLOCKED by RULES.md: this commit deletes permanent research files:" >&2
  printf '%b' "$blocked" >&2
  echo "Restore them (git restore --source=HEAD -- <path>) or get explicit user sign-off," >&2
  echo "then retry with ALLOW_MODEL_DELETE=1." >&2
  if [ "${ALLOW_MODEL_DELETE:-0}" != "1" ]; then exit 1; fi
fi
exit 0
