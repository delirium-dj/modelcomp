{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ModelComp",
  "short_name": "ModelComp",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "description": "Model comparison tool.",
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "255x255",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "255x255",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
